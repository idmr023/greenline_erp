# ============================================================
# Dashboard Flask — variables de entorno (copia a dashboard/.env)
#   cp .env.example .env
# En Vercel: Configuración → Environment Variables (Production/Preview)
# ============================================================

# Clave de Google Sheets API. Sólo se usa para DESCUBRIR las pestañas de las
# hojas con `hojas: "*"` (listar pestañas no se puede hacer por el CSV
# público). Crear en Google Cloud → APIs & Services → Credentials → API key,
# con «Application restrictions: None» y «API restrictions: Google Sheets API».
GOOGLE_SHEETS_API_KEY=

# URL base de la API Express del backend (la misma que usa el panel con
# VITE_API_URL). De aquí el dashboard lee los datos de los módulos del taller
# (incentivos, garantías, ensamblado).
#   Local: http://localhost:3000/api
#   Producción: la del backend desplegado (Render).
TALLER_API_URL=http://localhost:3000/api

# Token de servicio para leer los módulos del taller SIN panel (por ejemplo
# al abrir el dashboard en una pestaña aparte). Opcional: si no está, el
# dashboard usa el token del usuario que le entrega el panel por postMessage.
#   classic PAT → scope `repo` + `workflow`
#   fine-grained → permisos Contents y los del taller en lectura
TALLER_API_TOKEN=

# Orígenes autorizados a embeber el dashboard en un <iframe> (el ERP).
# Por defecto: localhost + la IP LAN de esta máquina. En producción define
# DASHBOARD_FRAME_ANCESTORS con la URL del panel.
# Ej.: "https://greenline-erp.onrender.com https://greenlineperu.com"
DASHBOARD_FRAME_ANCESTORS=
