# ============================================================
# Frontend (Vite) - copia este archivo a frontend/.env
#   cp frontend/.env.example frontend/.env
# En Vercel: Configuración → Environment Variables (Production/Preview)
# ============================================================

# URL base de la API Express (backend en Render).
# Local: http://localhost:3000/api
VITE_API_URL=

# Supabase (son PÚBLICAS por diseño: viajan en el bundle del navegador).
# La seguridad real la dan las políticas RLS, nunca estas claves.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL canónica del sitio, usada por SEOHead (canonical + og:url + og:image)
VITE_SITE_URL=https://greenlineperu.com

# Base que sirve el catálogo /assets/... (el ERP no hospeda esas imágenes:
# las rutas relativas de la DB se resuelven contra este origen).
# Por defecto se usa VITE_SITE_URL y luego https://greenline-eta.vercel.app.
# VITE_ASSETS_URL=https://greenline-eta.vercel.app

# Cache-busting de imágenes (?v=). Sube este valor para invalidar la caché.
VITE_IMAGE_VERSION=20260915

# Sentry (opcional). Sin esta variable es no-op, sin costo en local/dev.
VITE_SENTRY_DSN=
